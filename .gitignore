# Shortcuts store the absolute path of their target — machine-specific, and it would
# publish the folder layout of whoever made it. Everyone creates their own.
*.lnk

# Build output — the setup.exe belongs on a Releases page, not in the tree.
dist/

# Scratch folders used while diagnosing - never part of the product.
_diag/
_realcopy/

# Compiled launcher - built from launcher\ by build.ps1, shipped inside the installer.
build/
